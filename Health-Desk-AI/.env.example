# Java backend forwarding target for MedReach
JAVA_BACKEND_URL=http://localhost:9112/healthdesk/send/data/add-details-to-patient-video

# LLM providers
GOOGLE_API_KEY=change_me
GROQ_API_KEY=change_me

# Model/runtime options
MEDREACH_MODEL=gemini-2.5-flash
GOOGLE_GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_MODEL=llama-3.1-8b-instant

# Vector DB
PINECONE_API_KEY=change_me
PINECONE_INDEX_NAME=medical-bot

# Optional observability
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Medical-bot
